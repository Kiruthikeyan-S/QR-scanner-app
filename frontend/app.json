{
  "expo": {
    "name": "Qrinova",
    "slug": "qr-smart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qrsmart.scanner",
      "infoPlist": {
        "NSCameraUsageDescription": "Qrinova requires camera access to scan and decode QR codes in real-time.",
        "NSPhotoLibraryUsageDescription": "Qrinova needs photo library access to scan QR codes from your saved photos.",
        "NSPhotoLibraryAddUsageDescription": "Qrinova needs permission to save generated QR codes to your photo library."
      }
    },
    "android": {
      "package": "com.kiruthikeyan.scanner",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#071827",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Qrinova to access your camera to scan QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#071827"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "02cb596f-bccc-4e9c-ac1a-072f92e12b9e"
      }
    }
  }
}
